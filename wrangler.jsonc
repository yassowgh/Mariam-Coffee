// Cloudflare Workers config.
// Workers Builds runs `npx wrangler deploy`, which runs the build command below first.
// The KV namespace "DATA" and the D1 database "DB" have no ids: wrangler creates them
// automatically on the first deploy. The staff tables are created by the Worker itself.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mariam-coffee-db-reader",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // Website at mariamcoffeeshop.com, management app at mariamcoffeeshop.com/management/
  // workers.dev stays on: old links redirect from it and POS uploaders still upload to it.
  "workers_dev": true,
  "routes": [
    { "pattern": "mariamcoffeeshop.com", "custom_domain": true },
    { "pattern": "www.mariamcoffeeshop.com", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "DATA" }
  ],
  // Cloudflare Workers AI (free daily allowance): reads written schedule conditions
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "mariam-coffee-staff" }
  ],
  "vars": {
    // SHA-256 of the upload password. Set the secret UPLOAD_PASSWORD in the
    // Cloudflare dashboard to change the password without touching the code.
    "UPLOAD_PASSWORD_SHA256": "2d56d09035fc177a2960be607f0ce4d851389e84410d92c5fbd1bc063ce8e7b4"
  }
}
